<Window x:Class="FocusBlocker.App.PasswordDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accountability password" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <StackPanel Margin="26" MinWidth="380">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <PasswordBox x:Name="PasswordInput" Padding="11,9"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
            <Button Content="Continue" IsDefault="True" Click="Continue_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
