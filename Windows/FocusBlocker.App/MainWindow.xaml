<Window x:Class="FocusBlocker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus Blocker" Height="720" Width="900" MinHeight="620" MinWidth="720"
        Background="#F7F3EF" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Focus Blocker" FontSize="30" FontWeight="SemiBold" Foreground="#562A18"/>
            <TextBlock Text="Set a focus session for this Windows account." Margin="0,4,0,0" Foreground="#665B55"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,20,0,18" Padding="14" Background="White" CornerRadius="10">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="No session active" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountdownText" DockPanel.Dock="Right" Text="" FontSize="16" Foreground="#9A4B25" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="Websites to block in Chrome" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="One domain per line. Add an exception on the right to allow it." Foreground="#70645D" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox x:Name="DomainsBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" MinHeight="190" Padding="10"/>
                <TextBlock Text="Exceptions" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <TextBox x:Name="ExceptionsBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" MinHeight="100" Padding="10"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="Applications to close" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="One process name per line, without .exe. The app asks each process to close normally." Foreground="#70645D" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox x:Name="ProcessesBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" MinHeight="190" Padding="10"/>
                <TextBlock Text="Session length (minutes)" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <TextBox x:Name="DurationBox" Text="25" Width="100" HorizontalAlignment="Left" Padding="8"/>
                <CheckBox x:Name="StrictBox" Content="Strict session (can't stop early in this app)" IsChecked="True" Margin="0,14,0,0"/>
                <TextBlock Text="Chrome blocks require the included extension and native host. App closing works only while this window stays open." Foreground="#70645D" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>
        <WrapPanel Grid.Row="3" Margin="0,18,0,10">
            <Button x:Name="StartButton" Content="Start session" Click="Start_Click" Padding="18,10" Margin="0,0,10,0" Background="{StaticResource AccentBrush}" Foreground="White"/>
            <Button x:Name="StopButton" Content="End session" Click="Stop_Click" Padding="18,10" Margin="0,0,10,0" IsEnabled="False"/>
            <Button Content="Install Chrome host" Click="InstallHost_Click" Padding="18,10"/>
        </WrapPanel>
        <TextBlock Grid.Row="4" x:Name="HintText" Text="Early Windows preview. Sessions are limited to 12 hours." Foreground="#70645D" TextWrapping="Wrap"/>
    </Grid>
</Window>
