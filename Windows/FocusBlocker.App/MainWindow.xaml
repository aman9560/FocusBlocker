<Window x:Class="FocusBlocker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusBlocker" Height="790" Width="1040" MinHeight="670" MinWidth="800"
        Background="#F7F3EF" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,4,8,8"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <StackPanel><TextBlock Text="FocusBlocker" FontSize="28" FontWeight="SemiBold" Foreground="#562A18"/><TextBlock Text="Build a focus routine that works across apps and websites." Foreground="#665B55"/></StackPanel>
            <Border DockPanel.Dock="Right" Background="White" CornerRadius="10" Padding="14" VerticalAlignment="Center"><StackPanel><TextBlock x:Name="StatusText" Text="No session active" FontWeight="SemiBold"/><TextBlock x:Name="CountdownText" Foreground="#9A4B25"/></StackPanel></Border>
        </DockPanel>
        <TabControl Grid.Row="2" Margin="0,18,0,14" Background="Transparent">
            <TabItem Header="Focus session">
                <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,22,0"><TextBlock Text="Choose blocklists" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Combine lists for this session." Foreground="#70645D" Margin="0,3,0,10"/><ListBox x:Name="SessionLists" SelectionMode="Extended" MinHeight="220" DisplayMemberPath="Name"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><TextBlock Text="Length (minutes)" VerticalAlignment="Center"/><TextBox x:Name="DurationBox" Text="25" Width="90" Margin="12,0,20,0"/><TextBlock Text="Lock" VerticalAlignment="Center"/><ComboBox x:Name="SessionLockBox" Width="155"><ComboBoxItem Content="None"/><ComboBoxItem Content="Timer" IsSelected="True"/><ComboBoxItem Content="Password"/></ComboBox></StackPanel>
                        <CheckBox x:Name="StrictBox" Content="Strict session — protect the active rules" IsChecked="True" Margin="0,8,0,0"/>
                        <WrapPanel Margin="0,16,0,0"><Button x:Name="StartButton" Content="Start session" Click="Start_Click" Background="#9A4B25" Foreground="White"/><Button x:Name="StopButton" Content="End session" Click="Stop_Click" IsEnabled="False"/></WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="How enforcement works" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="The background agent requests blocked apps to close while a session is active. Chrome website rules require the included extension and native host. Strict sessions also close supported alternate browsers when enabled in Protection." TextWrapping="Wrap" Foreground="#665B55" Margin="0,8,0,12"/><Button Content="Install Chrome host" Click="InstallHost_Click" HorizontalAlignment="Left"/><TextBlock Text="Sessions can run up to 12 hours. Timer lock prevents early ending; password lock requires the accountability password. A Windows administrator can still stop or remove this per-user app." TextWrapping="Wrap" Foreground="#70645D" Margin="0,12,0,0"/></StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Blocklists"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><ListBox x:Name="BlocklistBox" DisplayMemberPath="Name" SelectionChanged="Blocklist_SelectionChanged" MinHeight="280"/><WrapPanel Margin="0,10,0,0"><Button Content="New" Click="NewBlocklist_Click"/><Button Content="Delete" Click="DeleteBlocklist_Click"/></WrapPanel><Button Content="Import sites…" Click="Import_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel>
                    <Grid Grid.Column="1" Margin="20,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="List name" FontWeight="SemiBold"/><TextBox x:Name="ListNameBox"/></StackPanel>
                        <StackPanel Grid.Row="1"><TextBlock Text="Websites and paths to block — one per line" FontWeight="SemiBold"/><TextBox x:Name="DomainsBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
                        <StackPanel Grid.Row="2"><TextBlock Text="Exceptions — one per line" FontWeight="SemiBold"/><TextBox x:Name="ExceptionsBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
                        <StackPanel Grid.Row="3"><TextBlock Text="Applications to close — process names, one per line" FontWeight="SemiBold"/><TextBox x:Name="ProcessesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
                        <Button Grid.Row="4" Content="Save blocklist" Click="SaveBlocklist_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Schedules"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Schedules" FontSize="18" FontWeight="SemiBold"/><ListBox x:Name="ScheduleBox" DisplayMemberPath="Name" MinHeight="330" Margin="0,8"/><Button Content="Delete selected schedule" Click="DeleteSchedule_Click" HorizontalAlignment="Left"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="22,0,0,0"><TextBlock Text="Add or update a weekly schedule" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Name"/><TextBox x:Name="ScheduleNameBox"/><TextBlock Text="Blocklists (Ctrl-click to select multiple)"/><ListBox x:Name="ScheduleLists" SelectionMode="Extended" DisplayMemberPath="Name" MinHeight="130" Margin="0,4,0,8"/>
                        <TextBlock Text="Days"/><WrapPanel x:Name="DaysPanel"><CheckBox Content="Sun" Tag="0" Margin="5"/><CheckBox Content="Mon" Tag="1" Margin="5"/><CheckBox Content="Tue" Tag="2" Margin="5"/><CheckBox Content="Wed" Tag="3" Margin="5"/><CheckBox Content="Thu" Tag="4" Margin="5"/><CheckBox Content="Fri" Tag="5" Margin="5"/><CheckBox Content="Sat" Tag="6" Margin="5"/></WrapPanel>
                        <WrapPanel><StackPanel><TextBlock Text="Start (local)"/><TextBox x:Name="ScheduleStartBox" Text="09:00" Width="100"/></StackPanel><StackPanel><TextBlock Text="End (local)"/><TextBox x:Name="ScheduleEndBox" Text="17:00" Width="100"/></StackPanel><StackPanel><TextBlock Text="Lock"/><ComboBox x:Name="ScheduleLockBox" Width="130"><ComboBoxItem Content="None"/><ComboBoxItem Content="Timer" IsSelected="True"/><ComboBoxItem Content="Password"/></ComboBox></StackPanel></WrapPanel>
                        <CheckBox x:Name="ScheduleStrictBox" Content="Strict schedule" IsChecked="True"/><Button Content="Save schedule" Click="SaveSchedule_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Protection"><StackPanel Margin="18" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Keep enforcement running" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="AgentBox" Content="Run FocusBlocker in the background and at sign-in" Margin="0,12,0,4"/><CheckBox x:Name="OtherBrowsersBox" Content="Close Edge, Firefox and other browsers during strict website sessions" Margin="0,4,0,12"/><Button Content="Save protection settings" Click="SaveProtection_Click" HorizontalAlignment="Left"/><Separator Margin="0,22"/><TextBlock Text="Accountability password" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="PasswordStatusText" Foreground="#665B55" Margin="0,4,0,8"/><TextBlock Text="New password (at least 8 characters)"/><PasswordBox x:Name="NewPasswordBox" Padding="8" Margin="0,4,0,8"/><TextBlock Text="Current password (when changing it)"/><PasswordBox x:Name="CurrentPasswordBox" Padding="8" Margin="0,4,0,8"/><Button Content="Set or change password" Click="SetPassword_Click" HorizontalAlignment="Left"/><Separator Margin="0,22"/><TextBlock Text="Protection is per Windows account. A user or administrator with system access can stop the agent, change local files, or uninstall it; this app does not install a tamper-proof driver." TextWrapping="Wrap" Foreground="#70645D"/></StackPanel></TabItem>
            <TabItem Header="Activity"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Recent activity" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Local event history with a chained integrity tag." Foreground="#70645D" Margin="0,4,0,8"/></StackPanel><ListView x:Name="ActivityList"><ListView.View><GridView><GridViewColumn Header="Time" DisplayMemberBinding="{Binding TimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" Width="190"/><GridViewColumn Header="Event" DisplayMemberBinding="{Binding Event}" Width="180"/><GridViewColumn Header="Details" DisplayMemberBinding="{Binding Detail}" Width="490"/></GridView></ListView.View></ListView></DockPanel></TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" x:Name="HintText" Text="Chrome extension is installed separately. Use the Extension folder in the complete Windows ZIP; see the README for setup." Foreground="#70645D" TextWrapping="Wrap"/>
    </Grid>
</Window>
