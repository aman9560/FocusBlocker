{
  "manifest_version": 3,
  "name": "Focus Blocker",
  "version": "0.1.0",
  "description": "Blocks distracting sites during Focus sessions. Rules come from the Focus app on this Mac.",
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "spanning",
  "permissions": [
    "declarativeNetRequest",
    "nativeMessaging",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Focus Blocker"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
